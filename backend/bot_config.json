      "enabled": false,
      "interval": "5m",
      "mode": "neutral",
      "distributionType": "arithmetic",
      "gridCount": 20,
      "smaPeriod": 100,
      "pivotLookback": 100,
      "atrPeriod": 14,
      "atrMultiplier": 8,
      "minWidthRatio": 0.5,
      "maxWidthRatio": 0.8,
      "asymmetryRatio": 1.3,
      "recenterHours": 24,
      "recenterBuffer": 0.03,
