      "gridCount": 20,
      "smaPeriod": 100,
      "pivotLookback": 100,
      "atrPeriod": 14,
      "atrMultiplier": 8,
      "minWidthRatio": 0.5,
      "maxWidthRatio": 0.8,
      "asymmetryRatio": 1.3,
      "recenterHours": 24,
      "recenterBuffer": 0.03,
      "baseOrder": 500,
      "leverage": 5,
      "takeProfit": 1.5,
      "trailingSteps": "1.5:0.3, 2.5:0.2, 4:0.12, 6:0.07, 10:0.03",
      "stopLoss": 65,
      "useDCA": true,
      "volMultiplier": 1,
