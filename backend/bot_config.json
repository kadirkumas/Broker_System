{
  "active": true,
  "scan_interval_seconds": 900,
  "position_check_seconds": 6,
  "max_symbols": 300,
  "auto_close_delisted": true,
  "daily_max_loss": 5,
  "max_open_positions": 100,
  "useLimitOrder": true,
  "limitTimeoutSec": 5,
  "fallbackToMarket": true,
  "strategies": {
    "RSI_SCALPER": {
      "enabled": false,
      "interval": "1m",
      "period": 7,
      "longOp": "<",
      "longVal": 20,
      "shortOp": ">",
      "shortVal": 90,
      "baseOrder": 5,
      "leverage": 5,
      "takeProfit": 1.5,
      "trailing": 0.3,
      "stopLoss": 50,
      "useDCA": true,
      "volMultiplier": 1,
      "steps": "5,10,15,20,28,38,48,60",
      "partialTPEnabled": true,
      "partialTPPercent": 50,
      "partialTPKeepDCA": true
    },
    "HULL_SRP": {
      "enabled": false,
      "interval": "4h",
      "period": 20,
      "source": "close",
      "minVolatility": 2,
      "longTrade": true,
      "shortTrade": true,
      "baseOrder": 20,
      "leverage": 5,
      "takeProfit": 4,
      "trailing": 1,
      "stopLoss": 50,
      "useDCA": true,
      "volMultiplier": 1,
      "steps": "5,15,25,35,45,60",
      "partialTPEnabled": true,
      "partialTPPercent": 50,
      "partialTPKeepDCA": true
    },
    "DYNAMIC_GRID": {
      "enabled": true,
      "interval": "1m",
      "mode": "neutral",
      "distributionType": "arithmetic",
      "gridCount": 20,
      "smaPeriod": 100,
      "pivotLookback": 100,
      "atrPeriod": 14,
      "atrMultiplier": 8,
      "minWidthRatio": 0.4,
      "maxWidthRatio": 0.8,
      "asymmetryRatio": 1.3,
      "recenterHours": 24,
      "recenterBuffer": 0.03,
      "baseOrder": 10,
      "leverage": 5,
      "takeProfit": 1,
      "trailing": 0.2,
      "stopLoss": 5,
      "useDCA": true,
      "volMultiplier": 1,
      "steps": "1, 2, 3, 5, 8",
      "partialTPEnabled": true,
      "partialTPPercent": 50,
      "partialTPKeepDCA": true
    }
  }
}