{
  "active": true,
  "scan_interval_seconds": 900,
  "position_check_seconds": 6,
  "max_symbols": 300,
  "auto_close_delisted": true,
  "daily_max_loss": 30,
  "max_open_positions": 200,
  "max_margin_ratio": 65,
  "useLimitOrder": true,
  "limitTimeoutSec": 3,
  "fallbackToMarket": true,
  "strategies": {
    "RSI_SCALPER": {
      "enabled": false,
      "interval": "1m",
      "period": 7,
      "longOp": "<",
      "longVal": 20,
      "shortOp": ">",
      "shortVal": 90,
      "baseOrder": 100,
      "leverage": 5,
      "takeProfit": 1.5,
      "trailingSteps": "1.5:0.3, 2.5:0.2, 4:0.12, 6:0.07, 10:0.03",
      "stopLoss": 65,
      "useDCA": true,
      "volMultiplier": 1,
      "steps": "5, 13, 25, 40, 60",
      "dcaMinDistancePct": 5,
      "dcaMinTimeMin": 15,
      "partialTPEnabled": true,
      "partialTPPercent": 50,
      "partialTPKeepDCA": true,
      "test_symbol": ""
    },
    "HULL_SRP": {
      "enabled": false,
      "interval": "4h",
      "period": 20,
      "source": "close",
      "minVolatility": 2,
      "longTrade": true,
      "shortTrade": true,
      "baseOrder": 10,
      "leverage": 5,
      "takeProfit": 1.5,
      "trailingSteps": "1.5:0.3, 2.5:0.2, 4:0.12, 6:0.07, 10:0.03",
      "stopLoss": 65,
      "useDCA": true,
      "volMultiplier": 1,
      "steps": "5, 13, 25, 40, 60",
      "dcaMinDistancePct": 5,
      "dcaMinTimeMin": 15,
      "partialTPEnabled": true,
      "partialTPPercent": 50,
      "partialTPKeepDCA": true,
      "test_symbol": "30"
    },
    "DYNAMIC_GRID": {
      "enabled": false,
