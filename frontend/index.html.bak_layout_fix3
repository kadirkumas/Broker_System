    <div id="chart-settings-modal" class="modal-overlay">
        <div class="modal-content chart-settings-content">
            <div class="modal-header">
                <h2>⚙️ Grafik Ayarları</h2>
                <span class="modal-close" onclick="closeChartSettingsModal()">✕</span>
            </div>

            <div class="chart-settings-body">
                <div class="cs-section">
                    <div class="cs-section-title">GRAFİK MARJLARI</div>

                    <div class="cs-row">
                        <span class="cs-label">Üst</span>
                        <input type="number" id="cs-margin-top" class="search-input" min="0" max="50" step="1" value="20">
                        <span class="cs-suffix">%</span>
                    </div>

                    <div class="cs-row">
                        <span class="cs-label">Alt</span>
                        <input type="number" id="cs-margin-bottom" class="search-input" min="0" max="50" step="1" value="20">
                        <span class="cs-suffix">%</span>
                    </div>

                    <div class="cs-row">
                        <span class="cs-label">Sağ</span>
                        <input type="number" id="cs-right-offset" class="search-input" min="0" max="50" step="1" value="5">
                        <span class="cs-suffix">çubuk</span>
                    </div>

                    <button class="cs-reset-btn" onclick="resetChartMargins()">Sıfırla</button>
                </div>

                <div class="cs-section">
                    <div class="cs-section-title">MUM RENKLERİ</div>

                    <div class="cs-row-check">
                        <input type="checkbox" id="cs-show-border" checked onchange="toggleBorderVisibility()">
                        <span class="cs-check-label">Temel hat</span>
                        <div class="cs-color-group">
                            <input type="color" id="cs-bg-up" class="cs-color" value="#089981" title="Yükseliş gövde">
                            <input type="color" id="cs-bg-down" class="cs-color" value="#f23645" title="Düşüş gövde">
                        </div>
                    </div>

                    <div class="cs-row-check">
                        <input type="checkbox" id="cs-show-wick" checked onchange="toggleWickVisibility()">
                        <span class="cs-check-label">Fitil</span>
                        <div class="cs-color-group">
                            <input type="color" id="cs-wick-up" class="cs-color" value="#089981" title="Yükseliş fitil">
                            <input type="color" id="cs-wick-down" class="cs-color" value="#f23645" title="Düşüş fitil">
                        </div>
                    </div>

                    <div class="cs-row-check">
                        <input type="checkbox" id="cs-show-candle-border" checked onchange="toggleCandleBorder()">
                        <span class="cs-check-label">Kenarlar</span>
                        <div class="cs-color-group">
                            <input type="color" id="cs-border-up" class="cs-color" value="#089981" title="Yükseliş kenar">
                            <input type="color" id="cs-border-down" class="cs-color" value="#f23645" title="Düşüş kenar">
                        </div>
                    </div>

                    <button class="cs-reset-btn" onclick="resetChartColors()">Sıfırla</button>
                </div>
            </div>

            <div class="chart-settings-footer">
                <button class="btn-secondary" onclick="closeChartSettingsModal()">Kapat</button>
                <button class="btn-primary" onclick="applyChartSettings()">💾 Uygula</button>
            </div>
        </div>
    </div>

    <script src="/static/chart.js"></script>
