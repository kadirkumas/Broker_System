                    if (!isBackground && i === data.length - 1 && Math.abs(nowSec - candle.time) <= window.getIntervalSeconds(cObj.interval) * 2) { window.triggerBackendClose(cObj.symbol, candle.time); } activeTrade = null; continue;
                }
